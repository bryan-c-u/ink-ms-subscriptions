# ============================================================================
#  ink-ms-subscriptions  ·  plantilla de variables de entorno
# ----------------------------------------------------------------------------
#  Copia este archivo a  .env  (misma carpeta) y rellena los valores reales.
#  El .env NO se commitea (.gitignore).
#  ESTE archivo (.env.example) SÍ se commitea: no pongas credenciales aquí.
#  En perfil `docker` estas variables van por `environment:` del compose, no aqui.
#
#  El .env se carga solo al arrancar via `spring.config.import` (application.yaml),
#  NO via spring-dotenv (esa libreria no carga el .env en este proyecto). No hace
#  falta exportar nada a mano: basta con que el .env exista junto al pom.xml.
# ============================================================================

# --- Mercado Pago (RF70) --------------------------------------------------------
# Panel: https://www.mercadopago.com.co/developers/panel/app  ->  Credenciales
# Usa las de PRUEBA (empiezan por TEST-) hasta que el flujo sandbox funcione.
# mock = siempre aprueba sin llamar a Mercado Pago. mercadopago = API real (sandbox
# con credenciales TEST-, o produccion con credenciales APP_USR-/live).
PAYMENT_GATEWAY_MODE=mercadopago
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_CURRENCY=COP

# "Clave secreta" del panel de MP (seccion Webhooks / Notificaciones).
# Con ella el backend valida la firma HMAC (x-signature) de cada webhook.
# Si se deja vacia, la firma NO se valida (aceptable en sandbox, NO en produccion).
MP_WEBHOOK_SECRET=

# URL PUBLICA a la que Mercado Pago enviara el webhook. En local, tunel a :3005
# (ngrok http 3005) y pega aqui la URL https con el path del webhook.
MP_NOTIFICATION_URL=https://TU-SUBDOMINIO.ngrok-free.app/api/pagos/mercadopago/webhook

# Rutas del frontend Angular a las que MP devuelve al usuario tras pagar.
MP_BACK_URL_SUCCESS=http://localhost:4200/pagos/exito
MP_BACK_URL_PENDING=http://localhost:4200/pagos/pendiente
MP_BACK_URL_FAILURE=http://localhost:4200/pagos/error

# --- Base de datos (MySQL en localhost:3306) ----------------------------------
# El schema `inklusport_subscriptions` se crea solo (createDatabaseIfNotExist=true).
DB_USERNAME=root
DB_PASSWORD=

# --- Correo del comprobante PDF (RF69) --------------------------------------
# Gmail: genera una "clave de aplicacion", no uses la contrasena normal.
# Si se dejan vacios, el pago se procesa igual y solo se omite el envio (WARN).
MAIL_USERNAME=
MAIL_PASSWORD=

# --- JWT: MISMO valor que en ink-ms-auth ------------------------------------
JWT_SECRET=inklusport2024superSecretKeyForJWTtokenGenerationWith512bitsAlgorithmHS512
AUTH_SERVICE_URL=http://localhost:3001

# --- Opcionales -------------------------------------------------------------
# COMPROBANTES_STORAGE_PATH=./comprobantes
# DIAS_AVISO_VENCIMIENTO=5
